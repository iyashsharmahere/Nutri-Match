# All optional. Copy to .env or set in your hosting dashboard.
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; default "*" (any site)
RATE_LIMIT_PER_MIN=60                   # per client, planning endpoints; 0 disables
TRUST_PROXY=0                           # set 1 behind a reverse proxy (reads X-Forwarded-For)
LOG_LEVEL=INFO
